{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": ".tsbuild",
    "types": ["vite/client"],
    "emitDeclarationOnly": true
  },
  "include": ["src", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
