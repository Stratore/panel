# --- Deployment (deploy/compose.yaml reads this file as deploy/.env, mode 600) ---
# Host name Caddy serves, e.g. panel.home.lan or panel.<tailnet>.ts.net.
PANEL_HOST=panel.home.lan
# TLS: "internal" (Caddy's own CA, default) or an e-mail address for public ACME certificates.
PANEL_TLS=internal
# Address Caddy binds to: your Tailscale IP, or 127.0.0.1 for local-only access. Never 0.0.0.0.
PANEL_BIND_ADDR=127.0.0.1
# Image tag to run (deploy/scripts/deploy.sh v1.2.0 updates it) and registry prefix.
PANEL_VERSION=latest
PANEL_IMAGE_PREFIX=ghcr.io/stratore/panel
# Public URL of the instance (https:// + PANEL_HOST): alert links and the API origin check.
PANEL_PUBLIC_URL=https://panel.home.lan
# Time zone of the quiet hours and of the daily digest (IANA name).
TZ=Europe/Paris
# 64 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# One-time token required by /setup on first launch.
SETUP_TOKEN=
# Optional. Raises NVD rate limits (https://nvd.nist.gov/developers/request-an-api-key).
NVD_API_KEY=
# Optional. Fine-grained token, read-only, no repository scope.
GITHUB_TOKEN=
# Optional alert channels (SPEC § 7.10). A malformed value disables its channel at startup.
# Discord: Server settings > Integrations > Webhooks, https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
# Telegram: token from @BotFather, chat id of the target chat (e.g. -1001234567890 or @channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=info
# Optional. Extra CIDRs safeFetch must never reach, comma-separated (e.g. your Docker network).
SAFE_FETCH_BLOCKED_CIDRS=
# Collector paths (defaults shown; Docker overrides them).
DATABASE_PATH=./data/panel.db
SOURCES_PATH=./config/sources.default.json
KEYWORDS_PATH=./config/keywords.json
# Optional. Daily SQLite backups go here (7 kept).
BACKUP_DIR=
# Optional. File the collector touches every minute (container healthcheck).
HEARTBEAT_FILE=
# API server (inside Docker, Caddy is the only exposed entry point).
HOST=127.0.0.1
PORT=3000
# Set to true behind Caddy so rate limits see the real client IP.
TRUST_PROXY=false
