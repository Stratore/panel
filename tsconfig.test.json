{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "apps/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.ts",
    "vitest.config.ts",
    "packages/*/drizzle.config.ts",
    "apps/api/src/testing.ts"
  ],
  "exclude": ["apps/web/**"]
}
